# Zugangsdaten für die Streamlit-Anwendung.
#
# So verwenden:
#   1. Diese Datei kopieren und in secrets.toml umbenennen
#      (also ohne die Endung .beispiel)
#   2. Das Passwort eintragen
#   3. Streamlit neu starten
#
# secrets.toml ist in .gitignore ausgeschlossen und landet nicht im Repository.
# Diese Beispieldatei enthält bewusst kein echtes Passwort.

[postgres]
user     = "postgres"
password = "HIER_DEIN_PASSWORT"
host     = "localhost"
port     = 5432
database = "bd_co2"
