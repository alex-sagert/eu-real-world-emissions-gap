# -----------------------------------------------------------------------------
# Rohdaten
#
# 01_daten/raw enthaelt rund 8,2 GB CSV. Sie gehoeren nicht ins Repository und
# sind vollstaendig aus 03_skripte reproduzierbar. Ausgenommen sind die kleinen
# Referenz- und Protokolldateien, die den Ladelauf belegen.
# -----------------------------------------------------------------------------
01_daten/raw/**
01_daten/interim/**
!01_daten/raw/.gitkeep
!01_daten/interim/.gitkeep
!01_daten/raw/_co2cars_tabellen.csv
!01_daten/raw/_download_co2cars_log.csv

# Referenztabellen sind klein und gehoeren dazu
!01_daten/referenz/**

# -----------------------------------------------------------------------------
# Arbeitsstaende, die nicht veroeffentlicht werden
# -----------------------------------------------------------------------------
_archiv/
*.state
*.sauber

# -----------------------------------------------------------------------------
# Das oeffentliche Repository zeigt die Analyse, nicht die Kursabgabe.
#
# Bericht und Critically Appraised Topic sind Pruefungsdokumente und gehen
# nur an die Hochschule. Die Praesentation bleibt, weil sie die Ergebnisse
# fuer sich erklaert und ohne Kurskontext lesbar ist.
# -----------------------------------------------------------------------------
06_abgabe/*CAT*
06_abgabe/*NvS*

# KNIME: nur die lauffaehige Endfassung, keine Zwischenstaende
04_knime/*_v[0-9].knwf
04_knime/basis.knwf
04_knime/Papier_gegen_Strasse.knwf

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Zugangsdaten - niemals einchecken
# -----------------------------------------------------------------------------
.env
*.pgpass
pgpass.conf
secrets.toml
.streamlit/secrets.toml
# Die Beispieldatei ohne Passwort gehoert dagegen ins Repository
!.streamlit/secrets.toml.beispiel

# -----------------------------------------------------------------------------
# KNIME
# -----------------------------------------------------------------------------
04_knime/**/tmp/
04_knime/_bau*/
*.knimeLock

# -----------------------------------------------------------------------------
# Office-Sperrdateien und temporaere Kopien
# -----------------------------------------------------------------------------
~$*
.~lock.*#
*.tmp

# -----------------------------------------------------------------------------
# Betriebssystem
# -----------------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
